# Alpaca API credentials (get from https://alpaca.markets/)
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# Trading mode (true = paper/safe, false = live/real money)
BOT_BROKER=alpaca
BOT_PAPER_ONLY=true

# Stock dry-run (true = log intended stock orders without submitting them)
BOT_STOCK_DRY_RUN=true
BOT_SHOW_ALPACA_PAPER=false
BOT_KILL_SWITCH=false
BOT_NOTIFY_TRADE_PREVIEW=true

# Latest price data (true = patch final bar with latest quote/trade before signals)
BOT_USE_LATEST_PRICE=true
BOT_REQUIRE_FRESH_PRICE_FOR_ORDERS=true
BOT_MAX_LATEST_PRICE_AGE_SEC=300
BOT_STALE_PRICE_BLOCKS_SELL=false
BOT_BLOCK_CAUTION_FEEDS_FOR_BUYS=false
BOT_MAX_BUYS_PER_CYCLE=0
BOT_MAX_SYMBOL_LOSS_PCT=8.0
BOT_BLOCK_BUY_GAP_UP_PCT=6.0

# Market data feed: sip is preferred for consolidated analysis if your Alpaca account has SIP access.
# Use auto only if you need fallback feeds; dashboard labels non-SIP/STALE prices as cautionary.
BOT_MARKET_DATA_FEED=sip

# Universe
# BOT_SYMBOL=SPY
# BOT_SYMBOLS=SPY,QQQ,AAPL
BOT_EXCLUDE_SYMBOLS=PARA,SQ

# Risk
BOT_MAX_SHARES=100
BOT_MAX_DAILY_TRADES=500
BOT_MAX_OPEN_POSITIONS=15
BOT_ORDER_FILL_TIMEOUT_SEC=120
BOT_TRAILING_STOP_PCT=2.0
BOT_PORTFOLIO_DRAWDOWN_HALT_PCT=10.0

# ATR-based risk sizing (new)
BOT_USE_ATR_STOPS=true
BOT_ATR_STOP_MULT=2.0
BOT_ATR_PERIOD=14
BOT_RISK_PER_TRADE_PCT=0.5   # % of equity to risk per trade

# Adaptive thresholds (new)
BOT_USE_ADAPTIVE_THRESHOLDS=true
BOT_BASE_BUY_THRESHOLD=0.15
BOT_BASE_SELL_THRESHOLD=-0.15

# Multi-timeframe confirmation (new)
BOT_USE_MTF_CONFIRMATION=true
BOT_MTF_TIMEFRAMES=1Day,1Hour

# Kelly sizing (legacy)
BOT_USE_KELLY_SIZING=true
BOT_KELLY_FRACTION=0.25
BOT_KELLY_MAX_SHARES=3

# Notifications
# BOT_WEBHOOK_URL=https://discord.com/api/webhooks/...
BOT_BUY_WEBHOOK_URL=
BOT_SELL_WEBHOOK_URL=
BOT_OTHER_WEBHOOK_URL=
BOT_NOTIFY_EVENTS=trade,error,risk_reject,daily_summary,drawdown,scanner_summary
BOT_DAILY_SUMMARY_TIME=21:00

# ML auto-retrain
BOT_ML_RETRAIN_DAYS=7

# Skip earnings lookups for ETF/fund symbols; add comma-separated symbols if needed.
BOT_EARNINGS_SKIP_SYMBOLS=

# EOD close
BOT_CLOSE_BEFORE_EOD=15

# Gap-open protection
BOT_GAP_OPEN_PROTECTION_PCT=4.0

# Partial profit
BOT_PARTIAL_PROFIT_TRIGGER_PCT=1.5
BOT_PARTIAL_PROFIT_SELL_PCT=75.0
BOT_PARTIAL_PROFIT_MAX_HOLD_BARS=0
BOT_PARTIAL_PROFIT_TRAILING_STOP_PCT=1.0

# Buy-the-dip
BOT_DIP_BUY_ENABLED=true
BOT_DIP_RSI_THRESHOLD=35
BOT_DIP_DROP_PCT=5.0
BOT_DIP_LOOKBACK_DAYS=20
BOT_DIP_LONG_MA_PERIOD=50
BOT_DIP_REQUIRE_UPTREND=true

# Bar cache (new)
BOT_CACHE_DIR=.cache/bars
BOT_CACHE_TTL_SEC=60
BOT_DASHBOARD_SCAN_RESULT_TTL_SEC=300

# Robinhood Agentic account (read-only readiness check)
# Set this to the account number Robinhood marks agentic_allowed=true.
# Robinhood mode records MCP order intents; final review/place happens through the Agentic connector.
ROBINHOOD_AGENTIC_ENABLED=false
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=
ROBINHOOD_AGENTIC_BUYING_POWER=0
ROBINHOOD_AGENTIC_EQUITY=0
ROBINHOOD_USE_DOLLAR_ORDERS=false
ROBINHOOD_DOLLAR_AMOUNT_PER_TRADE=0
ROBINHOOD_ORDER_INTENTS_PATH=logs/robinhood_order_intents.jsonl
ROBINHOOD_APPROVALS_PATH=logs/robinhood_approvals.jsonl
ROBINHOOD_QUOTES_PATH=logs/robinhood_quotes.json
ROBINHOOD_PORTFOLIOS_PATH=logs/robinhood_portfolios.json
ROBINHOOD_SNAPSHOT_TTL_SEC=300
