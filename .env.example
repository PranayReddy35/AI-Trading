# Alpaca API credentials (get from https://alpaca.markets/)
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# Trading mode (true = paper/safe, false = live/real money)
BOT_PAPER_ONLY=true

# Universe
# BOT_SYMBOL=SPY
# BOT_SYMBOLS=SPY,QQQ,AAPL

# Risk
BOT_MAX_SHARES=100
BOT_MAX_DAILY_TRADES=500
BOT_MAX_OPEN_POSITIONS=15
BOT_ORDER_FILL_TIMEOUT_SEC=120
BOT_TRAILING_STOP_PCT=2.0
BOT_PORTFOLIO_DRAWDOWN_HALT_PCT=10.0

# ATR-based risk sizing (new)
BOT_USE_ATR_STOPS=true
BOT_ATR_STOP_MULT=2.0
BOT_ATR_PERIOD=14
BOT_RISK_PER_TRADE_PCT=0.5   # % of equity to risk per trade

# Adaptive thresholds (new)
BOT_USE_ADAPTIVE_THRESHOLDS=true
BOT_BASE_BUY_THRESHOLD=0.15
BOT_BASE_SELL_THRESHOLD=-0.15

# Multi-timeframe confirmation (new)
BOT_USE_MTF_CONFIRMATION=true
BOT_MTF_TIMEFRAMES=1Day,1Hour

# Kelly sizing (legacy)
BOT_USE_KELLY_SIZING=true
BOT_KELLY_FRACTION=0.25
BOT_KELLY_MAX_SHARES=3

# Notifications
# BOT_WEBHOOK_URL=https://discord.com/api/webhooks/...
BOT_NOTIFY_EVENTS=trade,error,risk_reject,daily_summary,drawdown
BOT_DAILY_SUMMARY_TIME=21:00

# ML auto-retrain
BOT_ML_RETRAIN_DAYS=7

# EOD close
BOT_CLOSE_BEFORE_EOD=15

# Gap-open protection
BOT_GAP_OPEN_PROTECTION_PCT=4.0

# Partial profit
BOT_PARTIAL_PROFIT_TRIGGER_PCT=50.0
BOT_PARTIAL_PROFIT_SELL_PCT=50.0

# Buy-the-dip
BOT_DIP_BUY_ENABLED=true
BOT_DIP_RSI_THRESHOLD=35
BOT_DIP_DROP_PCT=5.0
BOT_DIP_LOOKBACK_DAYS=20
BOT_DIP_LONG_MA_PERIOD=50
BOT_DIP_REQUIRE_UPTREND=true

# Bar cache (new)
BOT_CACHE_DIR=.cache/bars
BOT_CACHE_TTL_SEC=60
